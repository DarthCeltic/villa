# Build output and dependencies are reproducible from package.json + the source; a repo
# that carries them makes every review diff unreadable and every merge a conflict.
node_modules/
dist/

# Screenshots are evidence of a QA run, not source. The QA script regenerates them, and
# committing binaries that change on every run is how a diff stops being readable.
qa/screenshots/

# TypeScript incremental build state. Generated by `tsc -b`, meaningless to a reader,
# and it changes on every build.
tsconfig.tsbuildinfo
