# ARGUS configuration. Copy to a file you source, or set these in your shell.
# Every value is optional: unset roots fall back to neutral defaults under ARGUS_HOME.
# Never put credentials in this file. The command token is generated on first start and lives
# under ARGUS_HOME/state, outside the repository.

# Where ARGUS keeps its state, runs, caches and components (default: ~/.argus)
ARGUS_HOME=

# The source checkout (default: the directory containing the argus package)
ARGUS_REPO=

# Data roots (each defaults to a directory under ARGUS_HOME)
ARGUS_RUNS_ROOT=
ARGUS_MODELS_ROOT=
ARGUS_REGISTRIES_ROOT=
ARGUS_SCIENCE_DATA_ROOT=
ARGUS_SCIENCE_CACHE_ROOT=
ARGUS_CACHE_ROOT=
ARGUS_UPSTREAM_ROOT=
ARGUS_RUNTIME_ROOT=
ARGUS_LEGACY_ROOT=

# Service ports. The UI proxies /api to ARGUS_API_PORT, so run the observatory there:
#   python -m argus.serve observe --port 8787
ARGUS_PORT=8787
ARGUS_COMMAND_PORT=8788
ARGUS_UI_TRANSPORT_PORT=8789

# UI dev server proxy (read by argus/ui/vite.config.ts)
ARGUS_UI_PORT=5173
ARGUS_API_PORT=8787
ARGUS_TRANSPORT_PORT=8789
